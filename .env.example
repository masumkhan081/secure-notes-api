# Server port (integer 1-65535, defaults to 4000)
PORT=4000

# Runtime environment: development | test | production
NODE_ENV=development

# Application MongoDB connection URI
MONGODB_URI="mongodb+srv://USERNAME:PASSWORD@CLUSTER/secure_notes?retryWrites=true&w=majority"

# 64-character hex secret for signing HS256 JWT access tokens
JWT_SECRET="replace-with-a-64-character-hex-secret"

# Comma-separated allowed CORS origins (defaults to http://localhost:5173)
CORS_ORIGINS=http://localhost:5173

# Number of reverse proxy hops to trust (integer 0-5, defaults to 0)
TRUST_PROXY_HOPS=0

# Initial admin seed credentials used only by `npm run seed:admin`
SEED_ADMIN_NAME="Notes Admin"
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="replace-with-a-password-of-at-least-12-characters"

# Dedicated test database URI required by `npm test` and `npm run verify:indexes`
# Must target the `secure_notes_test` database (never the application database)
TEST_MONGODB_URI="mongodb+srv://USERNAME:PASSWORD@CLUSTER/secure_notes_test?retryWrites=true&w=majority"
